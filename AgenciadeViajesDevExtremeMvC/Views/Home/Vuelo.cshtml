@{
    ViewData["Title"] = "Vuelo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Gesti&oacute;n de Vuelos</h2>

@(Html.DevExtreme().DataGrid<AgenciadeViajesDevExtremeMvC.Models.Vuelo>()
    .DataSource(ds => ds.WebApi()
        .Controller("Vuelo")
        .LoadAction("Get")
        .InsertAction("Post")
        .UpdateAction("Put")
        .DeleteAction("Delete")
        .Key("Id")
    )
    .RemoteOperations(true)
    .Columns(columns => {
        columns.AddFor(m => m.Id);

        columns.AddFor(m => m.Nombre);

        columns.AddFor(m => m.Tipo);

        columns.AddFor(m => m.Compañia);

        columns.AddFor(m => m.OrigenId).Lookup(lookup => lookup
            .DataSource(ds => ds.WebApi().Controller("Destino").LoadAction("Get").Key("Id"))
            .ValueExpr("Id")
            .DisplayExpr("NomDestino") // Asegúrate que este campo exista en la clase Destino
        );

        columns.AddFor(m => m.DestinoId).Lookup(lookup => lookup
            .DataSource(ds => ds.WebApi().Controller("Destino").LoadAction("Get").Key("Id"))
            .ValueExpr("Id")
            .DisplayExpr("NomDestino")
        );



        columns.AddFor(m => m.HoraSalida);

        columns.AddFor(m => m.HoraLlegada);

        columns.AddFor(m => m.Capacidad);

        columns.AddFor(m => m.Precio);
    })
     .Editing(e => e
        .Mode(GridEditMode.Popup)
        .AllowAdding(true)
        .AllowUpdating(true)
        .AllowDeleting(true)
    )
    .Paging(p => p.PageSize(8))
    .SearchPanel(s => s.Visible(true).Width(280))
   .Export(e => e
    .Enabled(true)
    .AllowExportSelectedData(false) // o true si querés solo lo seleccionado
)

    .HeaderFilter(f => f.Visible(true))
    .OnExporting("onExportingHandler")
)

<script>
    function onExportingHandler(e) {
        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet('Vuelos');

        DevExpress.excelExporter.exportDataGrid({
            component: e.component,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function () {
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Vuelos.xlsx");
            });
        });

        e.cancel = true;
    }
</script>
