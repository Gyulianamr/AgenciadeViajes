@{
    ViewData["Title"] = "AgentedeViaje";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2> Gesti&oacute;n de Agentes de Viajes</h2>

@(Html.DevExtreme().DataGrid<AgenciadeViajesDevExtremeMvC.Models.AgentedeViaje>()
    .DataSource(ds => ds.WebApi()
        .Controller("AgentedeViaje")
        .LoadAction("Get")
        .InsertAction("Post")
        .UpdateAction("Put")
        .DeleteAction("Delete")
        .Key("Id")
    )
    .RemoteOperations(true)
    .Columns(columns => {

        columns.AddFor(m => m.Id);

        columns.AddFor(m => m.Nombre);

        columns.AddFor(m => m.Apellido);

        columns.AddFor(m => m.Telefono);

        columns.AddFor(m => m.Correo);

        columns.AddFor(m => m.FechaContratacion);

        columns.AddFor(m => m.HoraLlegada);

        columns.AddFor(m => m.HoraSalida);

        columns.AddFor(m => m.Salario);
        columns.Add()
            .Type(GridCommandColumnType.Buttons)
            .Buttons(buttons =>
            {
                buttons.Add()
                    .Name(GridColumnButtonName.Edit)
                    .Icon("edit")
                    .Hint("Editar");

                buttons.Add()
                    .Name(GridColumnButtonName.Delete)
                    .Icon("trash")
                    .Hint("Eliminar");
            });


    })
       .Editing(e => e
        .Mode(GridEditMode.Popup)
        .AllowAdding(true)
        .AllowUpdating(true)
        .AllowDeleting(true)
    )
    .Paging(p => p.PageSize(8))
    .SearchPanel(s => s.Visible(true).Width(280))
   .Export(e => e
    .Enabled(true)
    .AllowExportSelectedData(false) // o true si querés solo lo seleccionado
)

    .HeaderFilter(f => f.Visible(true))
    .OnExporting("onExportingHandler")
)

<script>
    function onExportingHandler(e) {
        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet('AgentedeViaje');

        DevExpress.excelExporter.exportDataGrid({
            component: e.component,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function () {
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), "AgentedeViaje.xlsx");
            });
        });

        e.cancel = true;
    }
</script>
