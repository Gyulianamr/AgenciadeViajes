@{
    ViewData["Title"] = "Hotel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Gesti&oacute;n de Hotel</h2>

@(Html.DevExtreme().DataGrid<AgenciadeViajesDevExtremeMvC.Models.Hotel>()
    .DataSource(ds => ds.WebApi()
        .Controller("Hotel")
        .LoadAction("Get")
        .InsertAction("Post")
        .UpdateAction("Put")
        .DeleteAction("Delete")
        .Key("Id")
    )
    .RemoteOperations(true)
    .Columns(columns => {

        columns.AddFor(m => m.Id);

        columns.AddFor(m => m.Nombre);

        columns.AddFor(m => m.Estrellas);

        columns.AddFor(m => m.Direccion);

        columns.AddFor(m => m.TipoHabitacionId).Lookup(lookup => lookup
     .DataSource(ds => ds.WebApi()
         .Controller("TipoHabitacion")
         .LoadAction("Get")
         .Key("Id")
     )
     .ValueExpr("Id")
     .DisplayExpr("NombreHabitacion")
        );
    })
    .Editing(e => e
        .AllowAdding(true)
        .AllowUpdating(true)
        .AllowDeleting(true)
    )
            .Paging(p => p.PageSize(10))
.Pager(p => p.ShowPageSizeSelector(true).AllowedPageSizes(new[] { 5, 10, 20 }))
.FilterRow(f => f.Visible(true))
.SearchPanel(s => s.Visible(true).Width(240))
)
