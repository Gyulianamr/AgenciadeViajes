@{
    ViewData["Title"] = "Actividades";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Gesti&oacute;n de Actividades</h2>

@(Html.DevExtreme().DataGrid<AgenciadeViajesDevExtremeMvC.Models.Actividades>()
    .DataSource(ds => ds.WebApi()
        .Controller("Actividades")
        .LoadAction("Get")
        .InsertAction("Post")
        .UpdateAction("Put")
        .DeleteAction("Delete")
        .Key("Id")
    )
    .RemoteOperations(true)
    .Columns(columns => {

        columns.AddFor(m => m.Id);

        columns.AddFor(m => m.Nombre);

        columns.AddFor(m => m.Descripcion);

        columns.AddFor(m => m.DuracionHoras);

        columns.AddFor(m => m.RequiereReserva);

        columns.AddFor(m => m.PrecioHora);
    })
     .Editing(e => e
        .Mode(GridEditMode.Popup)
        .AllowAdding(true)
        .AllowUpdating(true)
        .AllowDeleting(true)
    )
    .Paging(p => p.PageSize(8))
    .SearchPanel(s => s.Visible(true).Width(280))
    .Export(export => export
        .Enabled(true)
        .AllowExportSelectedData(false)
    )
    .HeaderFilter(f => f.Visible(true))
    .OnExporting("onExportingHandler")
)

<script>
    function onExportingHandler(e) {
        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet('Actividades');

        DevExpress.excelExporter.exportDataGrid({
            component: e.component,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function () {
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Actividades.xlsx");
            });
        });

        e.cancel = true;
    }
</script>
