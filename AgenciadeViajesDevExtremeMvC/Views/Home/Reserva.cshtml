@{
    ViewData["Title"] = "Reserva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Gesti&oacute;n de Reservas</h2>

@(Html.DevExtreme().DataGrid<AgenciadeViajesDevExtremeMvC.Models.Reservacion>()
    .DataSource(ds => ds.WebApi()
        .Controller("Reservacion")
        .LoadAction("Get")
        .InsertAction("Post")
        .UpdateAction("Put")
        .DeleteAction("Delete")
        .Key("Id")
    )
    .RemoteOperations(true)
    .Columns(columns => {

        columns.AddFor(m => m.Id);
        columns.AddFor(m => m.IdCotizacion).Lookup(lookup => lookup
                    .DataSource(ds => ds.WebApi().Controller("Cotizacion").LoadAction("Get").Key("Id"))
                    .ValueExpr("Id")
                    .DisplayExpr("Id") // Muestra el nombre del cliente desde la cotización
                );



        columns.AddFor(m => m.FechaReservacion);

        columns.AddFor(m => m.Estado);

        columns.AddFor(m => m.FechaViaje);

        columns.AddFor(m => m.FechaRegreso);

        columns.AddFor(m => m.MontoPagado);

        columns.AddFor(m => m.Saldopendiente);
    })
             .Editing(e => e
        .Mode(GridEditMode.Popup)
        .AllowAdding(true)
        .AllowUpdating(true)
        .AllowDeleting(true)
    )
    .Paging(p => p.PageSize(8))
    .SearchPanel(s => s.Visible(true).Width(280))
   .Export(e => e
    .Enabled(true)
    .AllowExportSelectedData(false) // o true si querés solo lo seleccionado
)

    .HeaderFilter(f => f.Visible(true))
    .OnExporting("onExportingHandler")
)

<script>
    function onExportingHandler(e) {
        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet('Reserva');

        DevExpress.excelExporter.exportDataGrid({
            component: e.component,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function () {
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Reservas.xlsx");
            });
        });

        e.cancel = true;
    }
</script>