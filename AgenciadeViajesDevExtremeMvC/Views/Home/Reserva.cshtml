@{
    ViewData["Title"] = "Reserva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Gesti&oacute;n de Reservas</h2>

@(Html.DevExtreme().DataGrid<AgenciadeViajesDevExtremeMvC.Models.Reservacion>()
    .DataSource(ds => ds.WebApi()
        .Controller("Reservacion")
        .LoadAction("Get")
        .InsertAction("Post")
        .UpdateAction("Put")
        .DeleteAction("Delete")
        .Key("Id")


    )
    .RemoteOperations(true)
    .Columns(columns => {

        columns.AddFor(m => m.Id);





        columns.AddFor(m => m.IdCotizacion)

            .Lookup(lookup => lookup
                .DataSource(ds => ds.WebApi()
                    .Controller("Cotizacion") // Controlador de la API
                    .LoadAction("Get")        // Acción que devuelve las cotizaciones
                    .Key("Id"))               // Clave única de las cotizaciones
                .ValueExpr("Id")              // Valor que se almacenará en la columna (ID de la cotización)
                .DisplayExpr("Id")); // Texto mostrado (nombre del cliente)




        columns.AddFor(m => m.FechaReservacion);

        columns.AddFor(m => m.Estado);

        columns.AddFor(m => m.FechaViaje);

        columns.AddFor(m => m.FechaRegreso);
        columns.AddFor(m => m.IdCotizacion)
.Caption("Precio")
.AllowEditing(false) // Deshabilita la edición de esta columna
.Lookup(lookup => lookup
.DataSource(ds => ds.WebApi()
    .Controller("Cotizacion") // Controlador que devuelve los clientes
    .LoadAction("Get")     // Acción que devuelve los datos de los clientes
    .Key("Id"))            // Clave primaria del cliente
.ValueExpr("Id")           // Valor que se almacenará en la columna (ID del cliente)
.DisplayExpr("CostoTotal")); // Concatenación


        columns.AddFor(m => m.MontoPagado);

        columns.AddFor(m => m.Saldopendiente);

        columns.Add()
            .Type(GridCommandColumnType.Buttons)
            .Buttons(buttons =>
            {
                buttons.Add()
                    .Name(GridColumnButtonName.Edit)
                    .Icon("edit")
                    .Hint("Editar");

                buttons.Add()
                    .Name(GridColumnButtonName.Delete)
                    .Icon("trash")
                    .Hint("Eliminar");
            });
    })
             .Editing(e => e
        .Mode(GridEditMode.Popup)
        .AllowAdding(true)
        .AllowUpdating(true)
        .AllowDeleting(true)
    )
    .Paging(p => p.PageSize(8))
    .SearchPanel(s => s.Visible(true).Width(280))
   .Export(e => e
    .Enabled(true)
    .AllowExportSelectedData(false) // o true si querés solo lo seleccionado
)

    .HeaderFilter(f => f.Visible(true))
    .OnExporting("onExportingHandler")
)

<script>
    function onExportingHandler(e) {
        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet('Reserva');

        DevExpress.excelExporter.exportDataGrid({
            component: e.component,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function () {
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Reservas.xlsx");
            });
        });

        e.cancel = true;
    }
</script>