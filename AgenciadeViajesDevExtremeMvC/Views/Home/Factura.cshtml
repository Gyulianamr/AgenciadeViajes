@{
    ViewData["Title"] = "Factura";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Gesti&oacute;n de Facturas de Pagos</h2>

@(Html.DevExtreme().DataGrid<AgenciadeViajesDevExtremeMvC.Models.Factura>()
    .DataSource(ds => ds.WebApi()
        .Controller("Factura")
        .LoadAction("Get")
        .InsertAction("Post")
        .UpdateAction("Put")
        .DeleteAction("Delete")
        .Key("Id")
    )
    .RemoteOperations(true)
    .Columns(columns => {

        columns.AddFor(m => m.Id);

        columns.AddFor(m => m.ReservacionId).Lookup(lookup => lookup
            .DataSource(ds => ds.WebApi().Controller("Reservacion").LoadAction("Get").Key("Id"))
            .ValueExpr("Id")
            .DisplayExpr("FechaReservacion")
        );

        columns.AddFor(m => m.FechaPago);
        columns.AddFor(m => m.MetodoPagoId).Lookup(lookup => lookup
    .DataSource(ds => ds.WebApi().Controller("MetodoPago").LoadAction("Get").Key("Id"))
    .ValueExpr("Id")
    .DisplayExpr("Nombre")
);

        columns.AddFor(m => m.MontoPagado);



        columns.AddFor(m => m.Estado);
    })
               .Editing(e => e
        .Mode(GridEditMode.Popup)
        .AllowAdding(true)
        .AllowUpdating(true)
        .AllowDeleting(true)
    )
    .Paging(p => p.PageSize(8))
    .SearchPanel(s => s.Visible(true).Width(280))
   .Export(e => e
    .Enabled(true)
    .AllowExportSelectedData(false) // o true si querés solo lo seleccionado
)

    .HeaderFilter(f => f.Visible(true))
    .OnExporting("onExportingHandler")
)

<script>
    function onExportingHandler(e) {
        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet('Factura');

        DevExpress.excelExporter.exportDataGrid({
            component: e.component,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function () {
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Factura.xlsx");
            });
        });

        e.cancel = true;
    }
</script>

