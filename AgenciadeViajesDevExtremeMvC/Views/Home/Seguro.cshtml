@{
    ViewData["Title"] = "Seguro";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Gesti&oacute;n de Seguros</h2>

@(Html.DevExtreme().DataGrid<AgenciadeViajesDevExtremeMvC.Models.Seguro>()
    .DataSource(ds => ds.WebApi()
        .Controller("Seguro")
        .LoadAction("Get")
        .InsertAction("Post")
        .UpdateAction("Put")
        .DeleteAction("Delete")
        .Key("Id")
    )
    .RemoteOperations(true)
    .Columns(columns => {

        columns.AddFor(m => m.Id);

        columns.AddFor(m => m.Nombre);

        columns.AddFor(m => m.Tipo);

        columns.AddFor(m => m.Cobertura);

        columns.AddFor(m => m.DuracionDias);

        columns.AddFor(m => m.Precio);
    })
    .Editing(e => e
        .AllowAdding(true)
        .AllowUpdating(true)
        .AllowDeleting(true)
    )
            .Paging(p => p.PageSize(10))
.Pager(p => p.ShowPageSizeSelector(true).AllowedPageSizes(new[] { 5, 10, 20 }))
.FilterRow(f => f.Visible(true))
.SearchPanel(s => s.Visible(true).Width(240))

)
