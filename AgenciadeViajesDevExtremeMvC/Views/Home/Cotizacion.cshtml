@{
    ViewData["Title"] = "Cotizacion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>
    Gesti&oacute;n de Cotizaci&oacute;n
</h2>

@(Html.DevExtreme().DataGrid<AgenciadeViajesDevExtremeMvC.Models.Cotizacion>()
    .DataSource(ds => ds.WebApi()
        .Controller("Cotizacion")
        .LoadAction("Get")
        .InsertAction("Post")
        .UpdateAction("Put")
        .DeleteAction("Delete")
        .Key("Id")
    )
    .RemoteOperations(true)
    .Columns(columns => {

    columns.AddFor(m => m.Id);

    columns.AddFor(m => m.ClienteId)
.Lookup(lookup => lookup
    .DataSource(ds => ds.WebApi()
        .Controller("Cliente")
        .LoadAction("Get")
        .Key("Id"))
    .ValueExpr("Id")
    .DisplayExpr("Id"));

    columns.AddFor(m => m.ClienteId)
        .Caption("NombreCliente")
.AllowEditing(false)
.Lookup(lookup => lookup
.DataSource(ds => ds.WebApi()
.Controller("Cliente")
.LoadAction("Get")
.Key("Id"))
.ValueExpr("Id")
.DisplayExpr(new JS("function(item) { return item.Nombre + ' ' + item.Apellido; }")));

    columns.AddFor(m => m.AgenteResponsableId).Lookup(lookup => lookup
        .DataSource(ds => ds.WebApi().Controller("AgentedeViaje").LoadAction("Get").Key("Id"))
        .ValueExpr("Id")
        .DisplayExpr("Id")
        );

        columns.AddFor(m => m.AgenteResponsableId)
        .Caption("AgenteNombre")
.AllowEditing(false).Lookup(lookup => lookup
    .DataSource(ds => ds.WebApi().Controller("AgentedeViaje").LoadAction("Get").Key("Id"))
    .ValueExpr("Id")
    .DisplayExpr(new JS("function(item) { return item.Nombre + ' ' + item.Apellido; }"))
);

        columns.AddFor(m => m.PaqueteId).Lookup(lookup => lookup
            .DataSource(ds => ds.WebApi().Controller("Paquete_Turistico").LoadAction("Get").Key("Id"))
            .ValueExpr("Id")
            .DisplayExpr("Nombre")
        );

        columns.AddFor(m => m.CantidadPersonas);

        columns.AddFor(m => m.FechaCotizacion);

        columns.AddFor(m => m.CostoTotal);

        columns.Add()
            .Type(GridCommandColumnType.Buttons)
            .Buttons(buttons =>
            {
                buttons.Add()
                    .Name(GridColumnButtonName.Edit)
                    .Icon("edit")
                    .Hint("Editar");

                buttons.Add()
                    .Name(GridColumnButtonName.Delete)
                    .Icon("trash")
                    .Hint("Eliminar");
            });
    })
             .Editing(e => e
        .Mode(GridEditMode.Popup)
        .AllowAdding(true)
        .AllowUpdating(true)
        .AllowDeleting(true)
    )
    .Paging(p => p.PageSize(8))
    .SearchPanel(s => s.Visible(true).Width(280))
   .Export(e => e
    .Enabled(true)
    .AllowExportSelectedData(false) // o true si querés solo lo seleccionado
)

    .HeaderFilter(f => f.Visible(true))
    .OnExporting("onExportingHandler")
)

<script>
    function onExportingHandler(e) {
        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet('Cotizacion');

        DevExpress.excelExporter.exportDataGrid({
            component: e.component,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function () {
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Cotizacion.xlsx");
            });
        });

        e.cancel = true;
    }
</script>
