            </li>


        </ul>





    </nav>

    <!-- Menú lateral oculto -->
    <aside class="sidebar" id="sidebar">
        <button class="close-menu">X</button>
        <h3>Gesti&oacute;n de Servicios</h3>
        <ul class="sidebar-nav">
            <li>
                <a href="@Url.Action("Hotel", "Home")" class="nav-link">
                    <div class="nav-icon-text">
                        <img src="~/Content/building_18828479.png" alt="Hotel" style="width: 30px; height: 30px; margin-bottom: 5px;">
                        <span>Hotel</span>
                    </div>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Actividades", "Home")" class="nav-link">
                    <div class="nav-icon-text">
                        <img src="~/Content/actividad (2).png" alt="Actividades" style="width: 30px; height: 30px; margin-bottom: 5px;">
                        <span>Actividades</span>
                    </div>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Destino", "Home")" class="nav-link">
                    <div class="nav-icon-text">
                        <img src="~/Content/destino.png" alt="Destino" style="width: 30px; height: 30px; margin-bottom: 5px;">
                        <span>Destino</span>
                    </div>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Vuelo", "Home")" class="nav-link">
                    <div class="nav-icon-text">
                        <img src="~/Content/vuelo.png" alt="Vuelo" style="width: 30px; height: 30px; margin-bottom: 5px;">
                        <span>Vuelos</span>
                    </div>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Seguro", "Home")" class="nav-link">
                    <div class="nav-icon-text">
                        <img src="~/Content/seguro.png" alt="Vuelo" style="width: 30px; height: 30px; margin-bottom: 5px;">
                        <span>Seguro</span>
                    </div>
                </a>
            </li>
        </ul>
    </aside>


    <!-- Contenido principal -->
    <div class="container">
        <div class="main-content">
            @RenderBody()
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <p>&copy; 2025 <strong>Agencia de Viajes</strong> <i class="fas fa-plane"></i> Todos los derechos reservados.</p>

    </footer>

    <!-- Script para el menú -->


    <script>
        // Mostrar el menú
        document.querySelector('.menu-toggle').addEventListener('click', function () {
            document.getElementById('sidebar').classList.add('active');
        });

        // Cerrar el menú
        document.querySelector('.close-menu').addEventListener('click', function () {
            document.getElementById('sidebar').classList.remove('active');
        });
    </script>


    <script src="https://cdn3.devexpress.com/jslib/23.2.5/js/exceljs.min.js"></script>
    <script src="https://cdn3.devexpress.com/jslib/23.2.5/js/FileSaver.min.js"></script>
    <script>
        // Esperar a que todos los elementos estén listos
        $(document).ready(function () {
            // Este script se ejecutará para todos los DataGrid en la página
            $(".dx-datagrid").each(function () {
                const gridElement = $(this).dxDataGrid("instance");

                if (gridElement) {
                    const exportButton = $("<div>")
                        .dxButton({
                            icon: "exportxlsx",
                            text: "Exportar Excel",
                            onClick: function () {
                                DevExpress.excelExporter.exportDataGrid({
                                    component: gridElement,
                                    worksheet: workbook.addWorksheet("Datos"),
                                    autoFilterEnabled: true
                                }).then(() => {
                                    workbook.xlsx.writeBuffer().then((buffer) => {
                                        const blob = new Blob([buffer], { type: "application/octet-stream" });
                                        saveAs(blob, "DatosExportados.xlsx");
                                    });
                                });
                            }
                        });

                    // Agregar el botón al DOM, arriba del grid
                    $(this).before(exportButton);
                }
            });
        });

        // Incluir FileSaver.js si no lo tenés
    </script>

    <!-- CDN de FileSaver.js (necesario para guardar el Excel) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>



</body>
</html>


