                            <i class="fas fa-user-tie"></i> Agente de Viaje
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-link" href="@Url.Action("GuiaTuristico", "Home")">
                            <i class="fas fa-map-marked-alt"></i> Gu&#237;a Tur&#237;stico
                        </a>
                    </li>
                </ul>
            </li>

            <li class="nav-item">
                <a href="@Url.Action("Paquete", "Home")" class="nav-link" style="display: flex; align-items: center; gap: 8px;">
                    <img src="~/Content/paquete .png" alt="Paquetes Turísticos" style="width: 30px; height: 30px;">
                    Paquetes Tur&#237;sticos
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Cotizacion", "Home")" class="nav-link" style="display: flex; align-items: center; gap: 8px;">
                    <img src="~/Content/cotizacion.png" alt="Cotización" style="width: 30px; height: 30px;">
                    Cotizaci&oacute;n
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Reserva", "Home")" class="nav-link" style="display: flex; align-items: center; gap: 8px;">
                    <img src="~/Content/reserva.png" alt="Reservas" style="width: 30px; height: 30px;">
                    Reservas
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Factura", "Home")" class="nav-link" style="display: flex; align-items: center; gap: 8px;">
                    <img src="~/Content/factura.png" alt="Facturas" style="width: 30px; height: 30px;">
